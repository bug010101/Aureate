{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aureate",
  "version": "0.1.0",
  "identifier": "com.zhoujin.aureate",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aureate",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/fonts/*"],
    "category": "Productivity",
    "shortDescription": "Markdown writer with PDF-only output",
    "longDescription": "Aureate is a local-first Markdown writer. It previews on screen and exports only PDF, typeset by Typst, with fonts embedded. Cards turn notes into a searchable, reviewable research log.",
    "copyright": "© 2026 zhoujin",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
